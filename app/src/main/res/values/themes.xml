<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Footix" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Applique au lancement uniquement : l'activite bascule sur Theme.Footix
         des son onCreate, sinon le logo resterait derriere tout l'ecran. -->
    <style name="Theme.Footix.Splash" parent="Theme.Footix">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.Footix.Player" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

</resources>
